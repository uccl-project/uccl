+// NUMA partials use three/four sources and the merge uses two. Hoist their
+// pointers and keep four independent vectors in flight without changing the
+// per-element addition order or BF16 rounding (including NaN handling).
+template <size_t Sources>
+__attribute__((target("avx512f,avx512bw"))) static size_t sumWideFixed(
+    MemorySpan const* src, uint16_t* out, size_t n) {
+  uint16_t const* pointers[Sources];
+  for (size_t s = 0; s < Sources; ++s)
+    pointers[s] = static_cast<uint16_t const*>(src[s].address);
+  size_t i = 0;
+  for (; i + 64 <= n; i += 64) {
+    __m512 a = _mm512_setzero_ps(), b = a, c = a, d = a;
+    for (size_t s = 0; s < Sources; ++s) {
+      a = _mm512_add_ps(a, load(pointers[s] + i));
+      b = _mm512_add_ps(b, load(pointers[s] + i + 16));
+      c = _mm512_add_ps(c, load(pointers[s] + i + 32));
+      d = _mm512_add_ps(d, load(pointers[s] + i + 48));
+    }
+    store(out + i, a);
+    store(out + i + 16, b);
+    store(out + i + 32, c);
+    store(out + i + 48, d);
+  }
+  for (; i + 16 <= n; i += 16) {
+    __m512 v = _mm512_setzero_ps();
+    for (size_t s = 0; s < Sources; ++s)
+      v = _mm512_add_ps(v, load(pointers[s] + i));
+    store(out + i, v);
+  }
+  return i;
+}
