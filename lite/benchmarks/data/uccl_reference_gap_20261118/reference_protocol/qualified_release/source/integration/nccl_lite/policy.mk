# NCCL ABI policies. graph512 passed the recorded two-host/four-L4-per-host
# FP32 1-KiB–1-GiB qualification; the exact runtime profile is still required.
# Historical EXTRA_NVCC_FLAGS commands use UCCL_LITE_NCCL_POLICY=base.
UCCL_LITE_NCCL_POLICY ?= graph512
UCCL_LITE_NCCL_POLICY_FLAGS :=
UCCL_LITE_NCCL_POLICY_LIBS :=
UCCL_LITE_NCCL_POLICY_BASE := $(UCCL_LITE_NCCL_POLICY)
ifeq ($(UCCL_LITE_NCCL_POLICY),graph512)
UCCL_LITE_NCCL_POLICY_BASE := medium24
endif

ifeq ($(UCCL_LITE_NCCL_POLICY_BASE),medium24)
UCCL_LITE_NCCL_POLICY_FLAGS := \
  -DUCCL_LITE_HOST_GATHER_EXPERIMENT \
  -DUCCL_LITE_HOST_HYBRID_EXPERIMENT \
  -DUCCL_LITE_HOST_FUSE_FLAGS \
  -DUCCL_LITE_HOST_WARP_FLAGS \
  -DUCCL_LITE_HOST_COOPERATIVE_SM \
  -DUCCL_LITE_HOST_COOPERATIVE_ONE_PACKET \
  -DUCCL_LITE_RS_GRAPH_MIN_BYTES=16777216 \
  -DUCCL_LITE_AR_DIRECT_512K \
  -DUCCL_LITE_HOST_PERSISTENT_SM \
  -DUCCL_LITE_HOST_DEVICE_ACK_FENCE \
  -DUCCL_LITE_HOST_PUBLICATION_BLOCK \
  -DUCCL_LITE_HOST_CONSUMER_BLOCKS=16 \
  -DUCCL_LITE_HOST_COOPERATIVE_8M \
  -DUCCL_LITE_RS_FUSED_FINAL \
  -DUCCL_LITE_HOST_HYBRID_MIN_BYTES=1048576 \
  -DUCCL_LITE_AR256_THREADS=384 \
  -DUCCL_LITE_HOST_WARP_PUBLISHER \
  -DUCCL_LITE_HOST_GPU_GATES \
  -DUCCL_LITE_HOST_COOPERATIVE_MAX_SHARD=524288 \
  -DUCCL_LITE_INLINE_PACKET_DRAIN \
  -DUCCL_LITE_EARLY_PACKET_FLUSH \
  -DUCCL_LITE_AG_OVERLAP_OUTPUT \
  -DUCCL_LITE_ORDERED_SYNC_DRAIN \
  -DUCCL_LITE_PACKET_FIFO_PUBLISH \
  -DUCCL_LITE_RS_STREAM_512K \
  -DUCCL_LITE_AR_EARLY_FLUSH \
  -DUCCL_LITE_AR512_MEDIUM_BANKS \
  -DUCCL_LITE_HOST_SHARED_EVENT \
  -DUCCL_LITE_GRAPH_DESCRIPTOR_CACHE \
  -DUCCL_LITE_GRAPH_BINDING_CACHE \
  -DUCCL_LITE_RS_MEDIUM_BYTES=67108864 \
  -DUCCL_LITE_RS8M_REMOTE_FIRST \
  -DUCCL_LITE_RS_GRAPH_SINGLE_MAX_BYTES=67108864 \
  -DUCCL_LITE_HOST_SPIN_PROGRESS \
  -DUCCL_LITE_AG_DIRECT128 \
  -DUCCL_LITE_AR256_MEDIUM_BANKS \
  -DUCCL_LITE_AR256_RING_BLOCKS=8 \
  -DUCCL_LITE_RS128_PREFIX_BANKS \
  -DUCCL_LITE_QUERY_COMPLETION \
  -DUCCL_LITE_SYNC_PRIMARY_CONTEXT \
  -DUCCL_LITE_HOST_MEDIUM_CONSUMERS=24
UCCL_LITE_NCCL_POLICY_LIBS := -lcuda
ifeq ($(UCCL_LITE_NCCL_POLICY),graph512)
UCCL_LITE_NCCL_POLICY_FLAGS += -DUCCL_LITE_RS16M_GRAPH_BLOCKS=512
endif
else ifneq ($(UCCL_LITE_NCCL_POLICY),base)
$(error Unsupported UCCL_LITE_NCCL_POLICY '$(UCCL_LITE_NCCL_POLICY)'; choose base, medium24 or graph512)
endif
