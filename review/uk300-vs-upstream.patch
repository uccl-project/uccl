+		-L$(HIP_LIB) -lamdhip64 $(DEVICE_LIBS) $(TRANSPORT_LIBS) -lpthread \
+		-Wl,-soname,libnccl.so.2
+
+$(NCCL_OBJ): nccl.cc
+	$(CXX) -MMD -MP -c $< -o $@ $(CXXFLAGS) $(INCLUDES)
